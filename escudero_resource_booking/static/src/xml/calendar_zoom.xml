<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.CalendarController" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_calendar_navigation_buttons')]" position="after">
            <t t-if="props.resModel === 'resource.booking'">
                <div class="o_calendar_zoom_buttons btn-group d-print-none px-2 border-start">
                    <button class="btn btn-secondary" title="Zoom Out" t-on-click="zoomOut">
                        <i class="fa fa-search-minus"/>
                    </button>
                    <button class="btn btn-secondary" title="Zoom In" t-on-click="zoomIn">
                        <i class="fa fa-search-plus"/>
                    </button>
                </div>
            </t>
        </xpath>
    </t>

    <t t-inherit="web.CalendarCommonRenderer.event" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_event_title')]" position="replace">
            <t t-if="typeof isResourceBooking !== 'undefined' &amp;&amp; isResourceBooking">
                <!-- Premium Multi-Line Layout -->
                <div class="o_event_title">
                    <!-- Partner name logic -->
                    <t t-if="rawRecord &amp;&amp; rawRecord.partner_ids &amp;&amp; rawRecord.partner_ids.length > 0">
                         <t t-foreach="rawRecord.partner_ids" t-as="partnerId" t-key="partnerId">
                            <t t-if="model &amp;&amp; model.data &amp;&amp; model.data.partners &amp;&amp; model.data.partners[partnerId]">
                                <t t-esc="model.data.partners[partnerId].name"/>
                                <t t-if="!partnerId_last">, </t>
                            </t>
                         </t>
                    </t>
                    <t t-else="">
                        <t t-esc="title"/>
                    </t>
                </div>
                
                <div t-if="rawRecord &amp;&amp; rawRecord.description" class="o_event_description" t-out="rawRecord.description"/>
                
                <div t-if="rawRecord &amp;&amp; rawRecord.combination_id" class="o_event_resource">
                    <i class="fa fa-calendar-check-o small opacity-75"/>
                    <t t-esc="rawRecord.combination_id[1]"/>
                </div>

                <!-- Overlap Warning Icon -->
                <div t-if="rawRecord &amp;&amp; rawRecord.has_overlap" class="o_overlap_warning" title="Esta cita solapa con otra">
                    <i class="fa fa-warning"/>
                </div>
            </t>
            <t t-else="">
                <!-- Default Odoo behavior for other models -->
                <div class="o_event_title text-truncate">
                    <t t-esc="title"/>
                </div>
            </t>
        </xpath>

        <!-- Avoid duplicated descriptions for non-resource models -->
        <xpath expr="//div[hasclass('o_event_description')]" position="replace">
            <t t-if="typeof isResourceBooking === 'undefined' || !isResourceBooking">
                <div class="o_event_description text-truncate">
                    <t t-esc="rawRecord &amp;&amp; rawRecord.description"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>