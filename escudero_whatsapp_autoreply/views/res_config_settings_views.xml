<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp_autoreply" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp.autoreply</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="35" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Citas WhatsApp" name="escudero_whatsapp_autoreply">
                    <block title="Respuesta automática de WhatsApp" name="whatsapp_autoreply_block">
                        <setting
                            string="Responder automáticamente"
                            help="Al recibir un mensaje de WhatsApp se responde con una plantilla o un texto personalizado."
                        >
                            <field name="whatsapp_autoreply_enabled" />
                            <div class="content-group" invisible="not whatsapp_autoreply_enabled">
                                <div class="mt16">
                                    <label for="whatsapp_autoreply_mode" class="d-block fw-bold mb-1" />
                                    <field
                                        name="whatsapp_autoreply_mode"
                                        widget="radio"
                                        options="{'horizontal': true}"
                                    />
                                </div>
                                <div class="mt16" invisible="whatsapp_autoreply_mode != 'template'">
                                    <label for="whatsapp_autoreply_template_id" class="d-block fw-bold mb-1" />
                                    <field
                                        name="whatsapp_autoreply_template_id"
                                        class="w-100"
                                        required="whatsapp_autoreply_enabled and whatsapp_autoreply_mode == 'template'"
                                        options="{'no_create': True}"
                                    />
                                </div>
                                <div class="mt16" invisible="whatsapp_autoreply_mode != 'text'">
                                    <label for="whatsapp_autoreply_text" class="d-block fw-bold mb-1" />
                                    <field
                                        name="whatsapp_autoreply_text"
                                        class="w-100 border rounded p-2"
                                        style="min-height: 120px;"
                                        required="whatsapp_autoreply_enabled and whatsapp_autoreply_mode == 'text'"
                                        placeholder="Escribe el mensaje a enviar..."
                                    />
                                </div>
                                <div class="mt16">
                                    <label for="whatsapp_autoreply_cooldown_hours" class="d-block fw-bold mb-1" />
                                    <field name="whatsapp_autoreply_cooldown_hours" class="w-auto" />
                                    <div class="text-muted">0 = responder siempre.</div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
